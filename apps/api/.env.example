# Copy to apps/api/.env.local for local development. These are CONFIGURATION values, not secrets.
# Secrets live in a separate JSON document (generate one with: pnpm --filter @heed/scripts gen:local-secrets).
HEED_ENV=local
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=debug
# Exact origins only. Wildcards are rejected. Add your unpacked extension's origin when you have its id.
CORS_ALLOWED_ORIGINS=
HEED_RUNTIME_SECRETS_FILE=../../.secrets.local.json
