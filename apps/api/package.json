{
  "name": "@heed/api",
  "version": "0.0.0",
  "private": true,
  "description": "Heed API: stateless Fastify service. Stage 1 contains only the production foundation (health, readiness, errors, logging, CORS, request ids, OIDC-guarded scheduler endpoint).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@heed/config": "workspace:*",
    "@heed/shared": "workspace:*",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.13",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
